<dialog class="quote-game word-in-context" id="word-in-context" aria-labelledby="word-in-context-title">
  <form class="quote-close" method="dialog"><button type="submit" aria-label="Close Word in Context">×</button></form>
  <div class="quote-score">
    <label for="word-in-context-accuracy">Accuracy <output class="quote-percent" aria-live="polite">—</output></label>
    <meter id="word-in-context-accuracy" min="0" max="100" value="0"></meter>
  </div>
  <div class="quote-play">
    <header>
      <span class="quote-holly" aria-hidden="true"><i></i></span>
      <h2 id="word-in-context-title">Word in Context</h2>
    </header>
    <p class="quote-status">Choose the word that fills the gap.</p>
    <p class="quote-prompt" tabindex="-1" hidden></p>
    <div class="quote-options" role="group" aria-label="Answer choices" hidden></div>
    <div class="quote-result">
      <p class="quote-feedback" role="status"></p>
      <button class="quote-next" type="button" hidden>Next question</button>
    </div>
  </div>
  <div class="quote-pools" role="group" aria-label="Level">
    {% for level in [1, 2, 3] %}
    <button type="button" data-level="{{ level }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">Level {{ level }}</button>
    {% endfor %}
  </div>
  <script class="quiz-bank" type="application/json">{{ vocabularyBank | safe }}</script>
</dialog>
