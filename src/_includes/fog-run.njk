<dialog class="fog-run" id="fog-run" aria-label="Fog Run">
  <section class="fog-run-question" aria-labelledby="fog-run-label">
    <h3 class="fog-run-eyebrow" id="fog-run-label">Find the answer</h3>
    <p class="fog-run-clue" aria-live="polite" aria-atomic="true"></p>
  </section>
  <div class="fog-run-playfield">
    <div class="fog-run-map" role="img" aria-label="Snowy London street maze with Scrooge’s red nightcap, two haunted cash boxes and answers in the streets.">
      <canvas class="fog-run-roofs" width="660" height="484" aria-hidden="true"></canvas>
      <div class="fog-run-pickups" aria-hidden="true"></div>
      <canvas class="fog-run-piece fog-run-cap" width="48" height="48" aria-hidden="true"></canvas>
      <canvas class="fog-run-piece fog-run-box" width="48" height="48" aria-hidden="true"></canvas>
      <canvas class="fog-run-piece fog-run-box" width="48" height="48" aria-hidden="true"></canvas>
    </div>
    <div class="fog-run-cover">
      <section class="fog-run-card">
        <h3 class="fog-run-message"></h3>
        <p class="fog-run-detail"></p>
        <label class="fog-run-level">Difficulty
          <select><option value="1">1</option><option value="2">2</option><option value="3">3</option></select>
        </label>
        <button type="button" class="fog-run-action">Play Fog Run</button>
      </section>
    </div>
  </div>
  <aside class="fog-run-rail" aria-label="Game controls and score">
    <div class="fog-run-tools">
      <button type="button" class="fog-run-pause" aria-label="Pause" title="Pause" hidden><span aria-hidden="true">Ⅱ</span></button>
      <form method="dialog"><button class="fog-run-close" aria-label="Close Fog Run" title="Close">×</button></form>
    </div>
    <div class="fog-run-score"><span class="fog-run-eyebrow">Words</span><strong class="fog-run-count">0</strong></div>
    <div class="fog-run-life-panel"><span class="fog-run-eyebrow">Lives</span>
      <div class="fog-run-lives" role="img" aria-label="3 lives remaining">
        {% for i in [1, 2, 3] %}<canvas width="48" height="48" aria-hidden="true"></canvas>{% endfor %}
      </div>
    </div>
    <div class="fog-run-pad" aria-label="Steering controls" role="group">
      {% for direction in ["up", "left", "down", "right"] %}
      <button type="button" data-dir="{{ direction }}" aria-label="Steer {{ direction }}"><span aria-hidden="true"></span></button>
      {% endfor %}
    </div>
  </aside>
  <p class="fog-run-status" role="status"></p>
  <script type="application/json" class="fog-run-data">{{ fogRunBank | safe }}</script>
</dialog>
