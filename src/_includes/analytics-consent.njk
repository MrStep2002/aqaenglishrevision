<section id="ga-consent-notice" class="analytics-notice" aria-labelledby="ga-consent-title" hidden>
  <div class="analytics-notice-inner">
    <div>
      <h2 id="ga-consent-title">Optional visitor statistics</h2>
      <p>We use GoatCounter for basic visit counts. May we also use Google Analytics cookies to understand how the resources are used? <a href="/privacy#google-analytics">Privacy and choices</a>.</p>
    </div>
    <div class="analytics-actions">
      <button type="button" data-ga-consent="granted">Allow Google Analytics</button>
      <button type="button" data-ga-consent="denied">Decline</button>
    </div>
  </div>
</section>
