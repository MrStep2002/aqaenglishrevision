<dialog class="quote-game" id="plot-quiz" aria-labelledby="plot-quiz-title" data-question-bank data-advance-delay="750"{% if isThemeQuiz %} data-theme="{{ topic }}"{% endif %}>
  <form class="quote-close" method="dialog"><button type="submit" aria-label="Close Plot Quiz">×</button></form>
  <div class="quote-score">
    <label for="plot-quiz-accuracy">Accuracy <output class="quote-percent" aria-live="polite">—</output></label>
    <meter id="plot-quiz-accuracy" min="0" max="100" value="0"></meter>
  </div>
  <div class="quote-play">
    <header>
      <span class="quote-holly" aria-hidden="true"><i></i></span>
      <h2 id="plot-quiz-title">Plot Quiz</h2>
      {% if isThemeQuiz %}<p class="quote-status">{{ title }} questions</p>{% endif %}
    </header>
    <p class="quote-status" role="status"></p>
    <p class="quote-prompt" tabindex="-1" hidden></p>
    <div class="quote-options" role="group" aria-label="Answer choices" hidden></div>
    <div class="quote-result">
      <p class="quote-feedback" role="status"></p>
      <button class="quote-next" type="button" hidden>Next question</button>
    </div>
  </div>
  <script class="quiz-bank" type="application/json">{{ plotQuizBank | safe }}</script>
</dialog>
