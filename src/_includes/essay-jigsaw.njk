<dialog id="essay-jigsaw" class="quote-game plot-game" aria-labelledby="essay-jigsaw-title">
  <form class="quote-close" method="dialog"><button type="submit" aria-label="Close Essay Jigsaw">×</button></form>
  <div class="quote-play">
    <header>
      <h2 id="essay-jigsaw-title">Essay Jigsaw</h2>
      <p class="jigsaw-question" tabindex="-1"></p>
      <p>Use the arrows to put the sentences in order. Look for words that refer back to an earlier sentence.</p>
    </header>
    <ol class="plot-events" aria-label="Paragraph sentences"></ol>
  </div>
  <footer class="plot-actions">
    <p class="plot-feedback" role="status"></p>
    <button class="plot-check" type="button">Check order</button>
    <button class="jigsaw-next" type="button" hidden>Next paragraph</button>
  </footer>
</dialog>
