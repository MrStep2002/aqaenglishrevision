{% macro paragraphGame(game, bank) %}
{% set id = game.id | escape %}
{% set title = game.title | escape %}
{% set skin = game.skin or "section" %}
<dialog id="{{ id }}" class="quote-game essay-jigsaw" data-paragraph-game data-jigsaw-skin="{{ skin | escape }}" aria-labelledby="{{ id }}-title">
  <form class="quote-close" method="dialog">
    <button type="submit" aria-label="Close {{ title }}">×</button>
  </form>
  <header class="jigsaw-header">
    {% if skin == "christmas" %}
    <span class="quote-holly" aria-hidden="true"><i></i></span>
    {% endif %}
    <h2 id="{{ id }}-title">{{ title }}</h2>
    {% if skin == "christmas" %}
    <span class="quote-holly" aria-hidden="true"><i></i></span>
    {% endif %}
  </header>

  <div class="jigsaw-stage">
    <h3 class="jigsaw-question" tabindex="-1"></h3>
    <p class="jigsaw-guide">Drag or tap sentences in order. Tap a placed sentence to return it.</p>
    <div class="jigsaw-workbench">
      <div class="jigsaw-zone" role="group" aria-label="Your paragraph">
        <ol class="jigsaw-answer" role="list" aria-label="Placed sentences"></ol>
        <p class="jigsaw-placeholder">Drop sentences here</p>
      </div>
      <ul class="jigsaw-bank" role="list" aria-label="Available sentences"></ul>
    </div>

    <div class="jigsaw-solved" hidden>
      <p class="jigsaw-model" tabindex="-1"></p>
      <p class="jigsaw-explanation"></p>
    </div>
  </div>

  <footer class="jigsaw-footer">
    <p class="jigsaw-feedback" hidden></p>
    <div class="jigsaw-actions">
      <button class="jigsaw-hint" type="button">Hint</button>
      <button class="jigsaw-primary jigsaw-check" type="button" disabled>Check order</button>
      <button class="jigsaw-primary jigsaw-next" type="button" hidden>Next paragraph <span aria-hidden="true">→</span></button>
    </div>
  </footer>

  <p class="jigsaw-sr-only" role="status"></p>
  <span id="{{ id }}-place" hidden>Add to paragraph</span>
  <span id="{{ id }}-return" hidden>Return to available sentences</span>

  <template class="jigsaw-tile-template">
    <li class="jigsaw-tile">
      <button class="jigsaw-piece" type="button" aria-describedby="{{ id }}-place">
        <span class="jigsaw-grip" aria-hidden="true"></span>
        <span class="jigsaw-text"></span>
      </button>
    </li>
  </template>
  <script type="application/json" class="jigsaw-data">{{ bank | safe }}</script>
</dialog>
{% endmacro %}
