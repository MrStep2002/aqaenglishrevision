<dialog class="fog-run" id="fog-run" aria-labelledby="fog-title" data-phase="start">
  <header class="fog-header">
    <h2 id="fog-title">Fog Run</h2>
    <div class="fog-hud" hidden>
      <span class="fog-level"></span>
      <strong class="fog-count"></strong>
    </div>
    <button type="button" class="fog-pause" hidden>Pause</button>
    <form method="dialog"><button class="fog-close" aria-label="Close Fog Run">×</button></form>
  </header>
  <div class="fog-body">
    <section class="fog-start" aria-labelledby="fog-choose">
      <h3 id="fog-choose">Choose your ghost</h3>
      <p>Jump for the word that fits each clue. Catch ten to reach Fred’s Christmas party.</p>
      <div class="fog-ghosts">
        {% for name, difficulty, portrait in [["Past","Easy",51],["Present","Medium",52],["Yet to Come","Hard",53]] %}
        <button type="button" class="fog-ghost" data-level="{{ loop.index }}">
          <img src="/assets/pictures/acc/ACC-{{ portrait }}.jpg" alt="" width="480" height="480" loading="lazy">
          <span class="fog-plate">
            <small>Ghost of Christmas</small>
            <strong>{{ name }}</strong>
            <span class="fog-difficulty">{{ difficulty }}</span>
          </span>
        </button>
        {% endfor %}
      </div>
    </section>
    <section class="fog-question" hidden>
      <p class="fog-prompt-type"></p>
      <h3 id="fog-clue" aria-live="polite" aria-atomic="true"></h3>
      <p class="fog-meaning" hidden></p>
    </section>
    <div class="fog-street" hidden>
      <canvas aria-hidden="true"></canvas>
      <div class="fog-signs" aria-hidden="true"></div>
      <button type="button" class="fog-jump-zone" aria-label="Jump for a wreath" hidden></button>
    </div>
    <div class="fog-controls" hidden>
      <div class="fog-steer">
        <button type="button" data-direction="-1" aria-label="Run left">←</button>
        <button type="button" data-direction="1" aria-label="Run right">→</button>
        <span>Move</span>
      </div>
      <span class="fog-jump-help"><kbd>↑</kbd> or <kbd>Space</kbd> to jump</span>
      <span class="fog-tap-help">Tap the street to jump</span>
    </div>
    <section class="fog-result" hidden>
      <h3 tabindex="-1"></h3>
      <p></p>
      <button class="fog-action fog-again" type="button">Play again</button>
      <button class="fog-change" type="button">Change ghost</button>
    </section>
  </div>
  <script type="application/json" class="fog-data">{{ fogRunBank | safe }}</script>
</dialog>
