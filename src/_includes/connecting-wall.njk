<dialog class="quote-game connecting-wall" id="connecting-wall" aria-labelledby="connecting-wall-title" aria-describedby="connecting-wall-instructions" tabindex="-1">
  <form class="quote-close" method="dialog"><button type="submit" aria-label="Close Connecting Wall">×</button></form>
  <header class="wall-heading">
    <span class="quote-holly" aria-hidden="true"><i></i></span>
    <h2 id="connecting-wall-title">Connecting Wall</h2>
    <span class="quote-holly" aria-hidden="true"><i></i></span>
  </header>
  <div class="wall-settings">
    <div class="wall-levels" role="group" aria-label="Difficulty">
      <button type="button" data-wall-level="1" aria-pressed="true">Easy</button>
      <button type="button" data-wall-level="2" aria-pressed="false">Mid</button>
      <button type="button" data-wall-level="3" aria-pressed="false">Hard</button>
    </div>
    <p class="wall-progress">0 of 4 groups</p>
  </div>
  <p class="wall-instructions" id="connecting-wall-instructions">Select four words that belong together.</p>
  <div class="wall-stage">
    <div class="wall-board" role="group" aria-label="Four groups of four words"></div>
    <details class="wall-explanations" hidden>
      <summary>Why these words connect</summary>
      <ul></ul>
    </details>
  </div>
  <footer class="wall-footer">
    <p class="wall-feedback" role="status" aria-live="polite" aria-atomic="true"></p>
    <div class="wall-actions">
      <button type="button" data-wall-action="shuffle">Shuffle</button>
      <button type="button" data-wall-action="reveal">Show a group</button>
      <button type="button" data-wall-action="restart">Restart</button>
      <button type="button" class="wall-timer" aria-label="Start a three-minute timer">Timer: 3 min</button>
      <button type="button" class="wall-new" data-wall-action="new">New wall</button>
    </div>
  </footer>
  <script class="wall-bank" type="application/json">{{ connectingWallBank | safe }}</script>
</dialog>
